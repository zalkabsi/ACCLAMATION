# ── Twitch ────────────────────────────────────────────────────────────────────
# Create an app at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Broadcaster (channel) login. The token must belong to this user for chat reads.
TWITCH_CHANNEL=
# Filled in by `npm run auth`; override here only if you manage tokens yourself.
# TWITCH_USER_TOKEN=

# ── Model ─────────────────────────────────────────────────────────────────────
# Any OpenAI-compatible /chat/completions endpoint. Leave the key empty to run
# the fully offline local voice (great for the replay harness and tests).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# auto | openai | local
ACCLAMATION_PROVIDER=auto

# ── Behaviour ─────────────────────────────────────────────────────────────────
WINDOW_SECONDS=120
MIN_CHATTERS=4
# Comma or newline separated. Matched on word boundaries, case-insensitive.
BLOCKED_TERMS=
BLOCKED_USERS=
ALLOW_LINKS=false

# ── Voice ─────────────────────────────────────────────────────────────────────
# client = the overlay speaks with the browser voice (zero setup)
# openai = server-side speech, streamed to the overlay
# none   = captions only
TTS_PROVIDER=client
TTS_VOICE=onyx
TTS_MODEL=gpt-4o-mini-tts

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8787
HOST=127.0.0.1
MEMORY_PATH=.data/acclamation.sqlite
